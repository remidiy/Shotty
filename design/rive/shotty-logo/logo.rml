<Rive version="1" kind="fragment">
    <!-- Shotty's mark (apps/shotty-site/public/logo.svg) with eyes that say hello.
         Generated by make_rml.py; edit there. -->
    <Artboard defaultStateMachineId="0:2" styleId="0:3" width="512" height="512" name="Logo" id="0:1">
        <LayoutComponentStyle name="Logo Style" id="0:3"/>

        <!-- First declared paints on top: eyes, then the tile. -->
        <Node x="256" y="240.5" name="Eyes" id="0:20">
                <Shape x="-50.5" y="0" name="Left Eye">
                    <Rectangle width="67" height="123" cornerRadiusTL="33.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="White"/></Fill>
                </Shape>
                <Shape x="50.5" y="0" name="Right Eye">
                    <Rectangle width="67" height="123" cornerRadiusTL="33.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="White"/></Fill>
                </Shape>
        </Node>

        <Shape x="256" y="256" name="Tile" id="0:30">
            <Rectangle width="512" height="512" cornerRadiusTL="115" name="Path"/>
            <Fill name="Fill">
                <LinearGradient startX="0" startY="-256" endX="0" endY="256" name="Gradient">
                    <GradientStop colorValue="FF5C9EFF" position="0"/>
                    <GradientStop colorValue="FF335CF5" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <StateMachine name="Eyes" id="0:2">
            <StateMachineBool name="reduceMotion" id="0:40"/>
            <StateMachineTrigger name="hello" id="0:41"/>
            <StateMachineTrigger name="blink" id="0:42"/>

            <!-- Click (pointer down) anywhere on the logo: blink. -->
            <StateMachineListenerSingle targetId="0:30" listenerTypeValue="down" name="Click to Blink">
                <ListenerTriggerChange inputId="0:42"/>
            </StateMachineListenerSingle>
            <StateMachineLayer name="Eyes" id="0:4">
                <AnyState x="0" y="-150">
                    <StateTransition stateToId="0:12">
                        <TransitionTriggerCondition inputId="0:41"/>
                        <TransitionBoolCondition inputId="0:40" opValue="notEqual"/>
                    </StateTransition>
                </AnyState>
                <ExitState x="600" y="-150"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:13">
                        <TransitionBoolCondition inputId="0:40" opValue="equal"/>
                    </StateTransition>
                    <StateTransition stateToId="0:12"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:10" id="0:12">
                    <StateTransition stateToId="0:14" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                    <StateTransition stateToId="0:13">
                        <TransitionBoolCondition inputId="0:40" opValue="equal"/>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" y="0" animationId="0:11" id="0:14">
                    <StateTransition stateToId="0:13">
                        <TransitionBoolCondition inputId="0:40" opValue="equal"/>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="200" y="150" animationId="0:15" id="0:13"/>
            </StateMachineLayer>

            <!-- Runs beside "Eyes": waits (keys nothing), blinks on the trigger, returns. -->
            <StateMachineLayer name="Click" id="0:5">
                <AnyState x="0" y="250">
                    <StateTransition stateToId="0:17">
                        <TransitionTriggerCondition inputId="0:42"/>
                    </StateTransition>
                </AnyState>
                <ExitState x="600" y="250"/>
                <EntryState x="0" y="400">
                    <StateTransition stateToId="0:16"/>
                </EntryState>
                <AnimationState x="200" y="400" animationId="0:18" id="0:16"/>
                <AnimationState x="400" y="400" animationId="0:19" id="0:17">
                    <StateTransition stateToId="0:16" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <LinearAnimation name="intro" id="0:10" duration="120" loopValue="oneShot">
            <KeyedObject objectId="0:20"><KeyedProperty property="scaleY"><KeyFrameDouble frame="0" value="1" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDouble frame="15" value="1" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDouble frame="20" value="0.1" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDouble frame="25" value="1" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble></KeyedProperty><KeyedProperty property="x"><KeyFrameDouble frame="0" value="256" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDouble frame="25" value="256" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDouble frame="37" value="215.04" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDouble frame="49" value="215.04" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDouble frame="66" value="296.96" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDouble frame="77" value="296.96" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDouble frame="90" value="256" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble></KeyedProperty><KeyedProperty property="y"><KeyFrameDouble frame="0" value="240.5" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDouble frame="77" value="240.5" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble><KeyFrameDo